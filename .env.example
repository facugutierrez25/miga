# Copiá este archivo como .env para cambiar los valores locales.
# El archivo .env NUNCA se sube al repositorio.

# Email — verificación de cuenta
# Conseguí tu API key en https://resend.com (gratis, 100 mails/día)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXX
MAIL_FROM=noreply@tudominio.com
APP_BASE_URL=http://localhost:5173

# Clave para /actuator/metrics e /actuator/info (encabezado X-Ops-Key). Vacía = sin acceso.
OPS_API_KEY=

# Reparar el historial de Flyway al arrancar. Solo para una corrección puntual (ver runbook).
FLYWAY_REPAIR_ON_START=false

# Proxies de confianza y máximo de claves por tipo de límite.
RATE_LIMIT_TRUSTED_PROXIES=1
RATE_LIMIT_MAX_BUCKETS=10000

# Zona para el día de registro y la vigencia diaria de los planes.
APP_TIME_ZONE=America/Montevideo
